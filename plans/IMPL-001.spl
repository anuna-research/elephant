(normally r-assign-join-p2p (and ready-join-p2p agent-claude-available) assign-to-join-p2p-claude)
(normally r-assign-hardening (and ready-hardening agent-claude-available) assign-to-hardening-claude)
(normally r-assign-docs (and ready-docs agent-claude-available) assign-to-docs-claude)

(claims agent:claude
  :at "2026-07-10T14:28:00Z"
  (given claim-v1-shell-scaffold)
  (normally r-cl-state-v1-shell-scaffold claim-v1-shell-scaffold state-claimed-v1-shell-scaffold)
  (normally r-cl-chain-v1-shell-scaffold state-claimed-v1-shell-scaffold claimed-shell-scaffold)
)

;; Propagation rules: failures in 'shell-scaffold' block downstream tasks
(normally r-propagate-identity-from-shell-scaffold-failed failed-shell-scaffold upstream-blocked-identity)
(normally r-propagate-identity-from-shell-scaffold-permanently-failed permanently-failed-shell-scaffold upstream-blocked-identity)
(normally r-propagate-identity-from-shell-scaffold-stale-v1 stale-v1-shell-scaffold upstream-blocked-identity)
(normally r-propagate-identity-from-shell-scaffold-timeout-v1 timeout-v1-shell-scaffold upstream-blocked-identity)
(normally r-propagate-identity-from-shell-scaffold-blocked upstream-blocked-shell-scaffold upstream-blocked-identity)

;; Transitive propagation: upstream-blocked cascades through dependency chain
(normally r-propagate-envelope-from-identity-blocked upstream-blocked-identity upstream-blocked-envelope)
