(normally r-ready-queries (and task-queries completed-closure) ready-queries)
(normally r-ready-commitments (and task-commitments completed-closure) ready-commitments)
(normally r-ready-task-layer (and task-task-layer completed-queries) ready-task-layer)
(normally r-ready-daemon (and task-daemon completed-queries) ready-daemon)
(normally r-ready-e2ee (and task-e2ee completed-store) ready-e2ee)
(normally r-ready-join-p2p (and task-join-p2p completed-daemon completed-e2ee) ready-join-p2p)
(normally r-ready-hardening (and task-hardening completed-task-layer completed-commitments completed-join-p2p) ready-hardening)
(normally r-ready-docs (and task-docs completed-hardening) ready-docs)

