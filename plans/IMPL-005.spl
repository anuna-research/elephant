(normally r-assign-determinism (and ready-determinism agent-claude-available) assign-to-determinism-claude)
(normally r-assign-finish (and ready-finish agent-claude-available) assign-to-finish-claude)

(claims agent:claude
  :at "2026-07-14T13:24:18Z"
  (given claim-v1-vocab-core)
  (normally r-cl-state-v1-vocab-core claim-v1-vocab-core state-claimed-v1-vocab-core)
  (normally r-cl-chain-v1-vocab-core state-claimed-v1-vocab-core claimed-vocab-core)
)

;; Propagation rules: failures in 'vocab-core' block downstream tasks
